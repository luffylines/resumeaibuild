# Use a NEW, separate Supabase project for ResumeBuilder
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dedicated new Supabase project's PRIVATE server-side key, never NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# AI speech-to-text (optional, preferred when browser dictation fails)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Choose one server-side AI provider (never NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase Auth sends account emails using the SMTP settings in Supabase,
# not MAIL_* or RESEND_API_KEY values set only in Vercel.
